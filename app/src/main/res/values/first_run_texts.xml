<?xml version="1.0" encoding="utf-8"?>
<!--
    Words for the first screen of ParentMonitor.

    The screen describes what already exists before it asks anything, so the
    text names plain things - "этот телефон", "телефон ребёнка", "подключить" -
    and never asks the person to know what a family, an invitation or a member
    is. No step is longer than one decision.
-->
<resources>

    <!-- Step: what is already true -->
    <string name="first_run_welcome_title">Добро пожаловать в ChildWatch</string>
    <string name="first_run_welcome_subtitle">Настроим за два коротких шага. Ничего не потеряется, если закрыть приложение.</string>
    <string name="first_run_checking_server">Проверяем, что уже подключено…</string>
    <string name="first_run_step_format">Шаг %1$d из %2$d</string>
    <string name="first_run_child_phone_fallback">телефон ребёнка</string>
    <string name="first_run_already_title">Всё уже подключено</string>
    <string name="first_run_retry_check">Проверить снова</string>

    <!-- What the screen is allowed to say from the server's own answer -->
    <string name="first_run_in_family_title">Этот телефон уже в семье «%1$s»</string>
    <string name="first_run_in_family_body">Здесь вы — %1$s. Создавать семью или входить в неё не нужно.</string>
    <string name="first_run_linked_child_title">Связь с телефоном ребёнка работает</string>
    <string name="first_run_linked_child_body">Телефон ребёнка «%1$s» уже подключён. Этот телефон остаётся только подключить.</string>
    <string name="first_run_linked_child_known">Подключённый телефон ребёнка: «%1$s».</string>
    <string name="first_run_child_phones_many">Подключённые телефоны детей: %1$s.</string>
    <string name="first_run_known_child_title">Уже есть подключённый телефон ребёнка</string>
    <string name="first_run_known_child_body">Семья «%1$s» уже создана, и в ней есть телефон ребёнка — «%2$s». Создавать семью заново не нужно.</string>
    <string name="first_run_known_child_without_family_name">Семья уже создана, и в ней есть телефон ребёнка — «%1$s». Создавать семью заново не нужно.</string>
    <string name="first_run_known_child_body_unnamed">Семья уже создана, и телефон ребёнка в ней есть. Создавать семью заново не нужно.</string>
    <string name="first_run_connect_title">Подключим этот телефон</string>
    <string name="first_run_connect_subtitle">Семья и телефон ребёнка уже подключены — остался один шаг.</string>
    <string name="first_run_connect_needs_code">Попросите взрослого участника семьи открыть «Настройки» → «Семья» → «Пригласить» и выбрать ваше существующее имя. Затем отсканируйте код на этом телефоне.</string>
    <string name="first_run_empty_title">Этот телефон пока ни к чему не подключён</string>
    <string name="first_run_empty_body">Это нормально для первого запуска. Выберите, что сделать — дальше подскажу, какой телефон взять в руки.</string>
    <string name="first_run_offline_title">Сервер не отвечает</string>
    <string name="first_run_offline_body">Сейчас нельзя проверить, подключён ли этот телефон к семье. Проверьте интернет и попробуйте снова — или войдите в приложение и настроите позже.</string>

    <!-- Step 1: the person -->
    <string name="first_run_name_hint">Как вас зовут?</string>
    <string name="first_run_name_invalid">Введите имя — его увидят в семье</string>
    <string name="first_run_own_photo">Или выбрать своё фото</string>

