    <string name="first_run_invitation_hint">Код или ссылка приглашения</string>
    <string name="first_run_invitation_continue">Продолжить</string>
    <string name="first_run_invitation_scan">Сканировать код</string>
    <string name="first_run_invitation_cancel">Отмена</string>
