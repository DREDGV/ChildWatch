    <string name="first_run_open_app">Открыть приложение без настройки</string>
    <string name="first_run_continue">Продолжить</string>
    <string name="first_run_connected">Телефон подключён к семье</string>
    <string name="first_run_already_done">Этот телефон уже подключён — ничего делать не нужно.</string>
