    <string name="first_run_email_hint">Email</string>
    <string name="first_run_phone_hint">Телефон</string>
    <string name="first_run_email_invalid">Проверьте адрес email</string>
    <string name="first_run_phone_invalid">Проверьте номер телефона</string>

