<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cw_color_background">

    <ru.example.childwatch.designsystem.ChatCompactHeader
        android:id="@+id/compactChatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/connectionStatusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:visibility="visible"
        app:cardBackgroundColor="@color/cw_color_surface"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:rippleColor="@color/cw_color_primary_container"
        app:strokeColor="@color/cw_color_outline_variant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chatAvatar"
                style="@style/Widget.ChildWatch.Avatar.Medium"
                android:contentDescription="@string/family_profile_avatar_description"
                android:src="@drawable/avatar_family_ocean" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chatPartnerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_partner_child"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Header.Title" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp">

                    <View
                        android:id="@+id/connectionStatusIcon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/status_indicator_circle" />

                    <TextView
                        android:id="@+id/connectionStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/chat_presence_connecting"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Header.Status" />

                    <TextView
                        android:id="@+id/chatPartnerMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Meta"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Presence of the other side: a coloured dot plus text, on its own
                     row because the meta slot beside the sync text has no width. -->
                <LinearLayout
                    android:id="@+id/peerPresenceRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="2dp"
                    android:visibility="gone">

                    <View
                        android:id="@+id/peerPresenceDot"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/status_indicator_circle" />

                    <TextView
                        android:id="@+id/peerPresenceText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Meta" />
                </LinearLayout>

                <!-- Who is in a group conversation. A family chat and a direct
                     conversation have no such line and leave it gone. -->
                <TextView
                    android:id="@+id/chatMembersText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Meta"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chatPersonLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:text="@string/family_location_unavailable"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Meta"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chatInfoButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/chat_info_button_desc"
                app:icon="@android:drawable/ic_menu_info_details" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/typingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/chat_typing_child"
        android:textSize="12sp"
        android:textColor="@color/cw_color_on_surface_variant"
        android:textStyle="italic"
        android:visibility="gone"
        android:gravity="start" />

    <LinearLayout
        android:id="@+id/loadingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:indeterminate="true"
            app:indicatorSize="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_loading_messages"
            android:textColor="@color/cw_color_on_surface_variant"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/emptyStateCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/emptyStateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_empty_title"
                android:textColor="#1F1F1F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/emptyStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/chat_empty_hint"
                android:textColor="#6B7280"
                android:textSize="14sp" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:overScrollMode="never" />

    <LinearLayout
        android:id="@+id/chatHistoryNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/chatHistoryContinue"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/chat_history_continue" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/chatHistoryLatest"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/chat_history_latest" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/newMessagesButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="6dp"
        android:text="@string/chat_v2_new_messages"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cw_color_outline_variant" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        android:backgroundTint="@color/cw_color_surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/cw_space_2"
            android:paddingTop="@dimen/cw_space_2"
            android:paddingBottom="@dimen/cw_space_3">

            <LinearLayout
                android:id="@+id/chatReplyPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/cw_chat_quote_surface"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:visibility="gone">
                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/cw_color_primary"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:id="@+id/chatReplySource"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp">
                    <TextView
                        android:id="@+id/chatReplyAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Sender" />
                    <TextView
                        android:id="@+id/chatReplyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/cw_color_on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chatReplyCancel"
                    style="@style/Widget.ChildWatch.Chat.HeaderAction"
                    android:contentDescription="@string/chat_reply_cancel"
                    app:icon="@drawable/cw_chat_dismiss" />
            </LinearLayout>

            <LinearLayout android:id="@+id/attachmentDraftPanel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone" android:paddingBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <ImageView android:id="@+id/attachmentDraftImage" android:layout_width="56dp" android:layout_height="56dp"
                        android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="@string/chat_media_preview" />
                    <TextView android:id="@+id/attachmentDraftText" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="8dp" android:maxLines="3"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Chat.ComposerHint" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/attachmentDraftCancel"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/chat_media_remove" />
                </LinearLayout>
                <ProgressBar android:id="@+id/attachmentDraftProgress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="4dp" android:visibility="gone" android:max="100" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emojiButton"
                    style="@style/Widget.ChildWatch.Chat.Action"
                    android:contentDescription="@string/chat_emoji_button_content_description"
                    android:tooltipText="@string/chat_emoji_button_label"
                    app:icon="@drawable/ic_emoji"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/cw_color_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/attachmentButton" style="@style/Widget.ChildWatch.Chat.Action"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:contentDescription="@string/chat_media_attach" android:tooltipText="@string/chat_media_attach"
                    android:visibility="gone" app:icon="@drawable/ic_chat_attach" app:iconPadding="0dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ChildWatch.Chat.Composer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cw_space_1"
                    android:layout_marginEnd="@dimen/cw_space_2"
                    android:layout_weight="1">

                    <com.vanniktech.emoji.EmojiEditText
                        android:id="@+id/messageInput"
                        style="@style/Widget.ChildWatch.Chat.Composer.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/chat_input_hint" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendButton"
                    style="@style/Widget.ChildWatch.Chat.Send"
                    android:contentDescription="@string/chat_send"
                    android:enabled="false"
                    app:icon="@drawable/ic_send" />

            </LinearLayout>

            <TextView
                android:id="@+id/composerMetaText"
                style="@style/TextAppearance.ChildWatch.Chat.ComposerHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_1"
                android:paddingStart="@dimen/cw_space_4"
                android:text="@string/chat_composer_hint_online"
                android:textSize="12sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
