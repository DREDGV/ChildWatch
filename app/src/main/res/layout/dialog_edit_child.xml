<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:theme="@style/ThemeOverlay.ChildWatch.Material3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/childAvatarImage"
            style="@style/Widget.ChildWatch.Avatar.Hero"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/family_profile_avatar_description"
            android:src="@drawable/avatar_family_mint"
            android:scaleType="centerCrop" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/family_profile_avatar_presets"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/cw_color_on_surface_variant" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatarPreset1"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/avatar_family_sky"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ChildWatch.Avatar" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatarPreset2"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/avatar_family_mint"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ChildWatch.Avatar" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatarPreset3"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/avatar_family_sun"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ChildWatch.Avatar" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatarPreset4"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/avatar_family_coral"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ChildWatch.Avatar" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatarPreset5"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/avatar_family_lilac"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ChildWatch.Avatar" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatarPreset6"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/avatar_family_ocean"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ChildWatch.Avatar" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changeAvatarButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/family_profile_choose_photo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectContactButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/family_profile_from_contacts"
                app:icon="@android:drawable/ic_menu_search" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/family_profile_person_section"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="@string/family_profile_person_hint"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/cw_color_on_surface_variant" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/childNameInputLayout"
            style="@style/Widget.ChildWatch.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/family_profile_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/childNameInput"
                style="@style/Widget.ChildWatch.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/roleInputLayout"
            style="@style/Widget.ChildWatch.TextInputLayout.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/family_profile_role">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/roleInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/family_profile_connection_section"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="@string/family_profile_connection_hint"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/cw_color_on_surface_variant" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/deviceIdInputLayout"
            style="@style/Widget.ChildWatch.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/family_profile_device_code"
            app:endIconContentDescription="@string/family_profile_paste_code"
            app:endIconDrawable="@android:drawable/ic_menu_upload"
            app:endIconMode="custom"
            app:helperText="@string/family_profile_device_code_hint"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/deviceIdInput"
                style="@style/Widget.ChildWatch.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanQrButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/family_profile_scan_qr"
            app:icon="@android:drawable/ic_menu_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/advancedOptionsButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="start|center_vertical"
            android:text="@string/family_profile_more_settings"
            app:icon="@android:drawable/arrow_down_float" />

        <LinearLayout
            android:id="@+id/advancedOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/childAgeInputLayout"
                style="@style/Widget.ChildWatch.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/family_profile_age"
                app:suffixText="@string/family_profile_years_suffix">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/childAgeInput"
                    style="@style/Widget.ChildWatch.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/childPhoneInputLayout"
                style="@style/Widget.ChildWatch.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/family_profile_phone"
                app:endIconContentDescription="@string/family_profile_from_contacts"
                app:endIconDrawable="@android:drawable/ic_menu_call"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/childPhoneInput"
                    style="@style/Widget.ChildWatch.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/iconInputLayout"
                style="@style/Widget.ChildWatch.TextInputLayout.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/family_profile_map_marker">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/iconInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/family_profile_permissions"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:text="@string/family_profile_permissions_hint"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/cw_color_on_surface_variant" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/featureChatCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/family_profile_feature_chat" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/featureMapCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/family_profile_feature_map" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/featureAudioCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/family_profile_feature_audio" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/featurePhotoCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/family_profile_feature_photo" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
