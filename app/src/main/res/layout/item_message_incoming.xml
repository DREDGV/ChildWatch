<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="40dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:gravity="start"
    android:orientation="vertical">

    <TextView
        android:id="@+id/senderText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="2dp"
        android:text="@string/chat_partner_child"
        android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Sender" />

    <LinearLayout android:id="@+id/attachmentCard" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp"
        android:background="@color/cw_color_primary_container" android:visibility="gone" android:minWidth="160dp" android:layout_marginTop="4dp">
        <ImageView android:id="@+id/attachmentImage" android:layout_width="200dp" android:layout_height="150dp"
            android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="@string/chat_media_preview" />
        <TextView android:id="@+id/attachmentName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="3" android:textColor="@color/cw_color_on_surface" android:textSize="15sp" />
        <TextView android:id="@+id/attachmentMeta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/cw_color_on_surface_variant" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/attachmentOpen"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/chat_media_open" />
    </LinearLayout>

    <com.vanniktech.emoji.EmojiTextView
        android:id="@+id/messageText"
        style="@style/Widget.ChildWatch.ChatBubble.Incoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/timestampText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:text="12:34"
        android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Meta" />

</LinearLayout>
