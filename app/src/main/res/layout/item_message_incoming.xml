<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="40dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:gravity="start"
    android:orientation="vertical">

    <TextView
        android:id="@+id/senderText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="2dp"
        android:text="@string/chat_partner_child"
        android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Sender" />

    <com.vanniktech.emoji.EmojiTextView
        android:id="@+id/messageText"
        style="@style/Widget.ChildWatch.ChatBubble.Incoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/timestampText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:text="12:34"
        android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Meta" />

</LinearLayout>
