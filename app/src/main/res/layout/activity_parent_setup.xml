<?xml version="1.0" encoding="utf-8"?>
<!--
    The first screen of ParentMonitor, written as steps rather than as one form.

    It opens by stating what is already true — this phone is in a family, or the
    home of the child is already connected — and only then asks the one question
    the current step needs. Every screen keeps a way out, so a person who skips
    never has to reinstall to find this screen again.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cw_color_background"
    tools:context=".ParentSetupActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/firstRunScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="164dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/cw_space_6"
            android:paddingTop="@dimen/cw_space_8"
            android:paddingEnd="@dimen/cw_space_6"
            android:paddingBottom="@dimen/cw_space_6">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/first_run_welcome_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/cw_color_on_surface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_2"
                android:text="@string/first_run_welcome_subtitle"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/cw_color_on_surface_variant" />

            <!--
                What is already true. It is filled from the server's own answer,
                so the screen never offers to create a family this phone is
                already in.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/stateCard"
                style="@style/Widget.ChildWatch.PersonCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_5"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/cw_space_4">

                    <TextView
                        android:id="@+id/stateTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Person.Name"
                        tools:text="Этот телефон уже в семье «Семья»" />

                    <TextView
                        android:id="@+id/stateBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_1"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Person.Supporting"
                        tools:text="Здесь вы — Папа." />

                    <TextView
                        android:id="@+id/stateLinkTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_3"
                        android:text="@string/first_run_linked_child_title"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Status.Success"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/stateLinkBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_1"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Person.Meta"
                        android:visibility="gone"
                        tools:text="Телефон ребёнка «moto g 5G plus» уже подключён — эта связь работает." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/stepIndicatorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_6"
                android:textAppearance="@style/TextAppearance.ChildWatch.Person.Meta"
                android:visibility="gone"
                tools:text="Шаг 1 из 2" />

            <!--
                One decision belongs to this container. The name is the only
                field every path needs; the family question appears only for a
                phone that nothing is known about.
            -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameInputLayout"
                style="@style/Widget.ChildWatch.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_4"
                android:hint="@string/first_run_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nameInput"
                    style="@style/Widget.ChildWatch.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/choiceGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_2"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/choiceLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_4"
                    android:text="@string/first_run_choice_label"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Person.Name" />

                <!--
                    Both ways in are offered side by side and with the same
                    weight. Creating a family used to be the only visible path,
                    so a phone that meant to join an existing family started one
                    of its own instead.
                -->
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/createFamilyRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_3"
                    android:text="@string/first_run_choice_start" />

                <TextView
                    android:id="@+id/createFamilyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cw_space_6"
                    android:text="@string/first_run_choice_start_hint"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Person.Meta" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/joinFamilyRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_2"
                    android:checked="true"
                    android:text="@string/first_run_choice_join" />

                <TextView
                    android:id="@+id/joinFamilyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cw_space_6"
                    android:text="@string/first_run_choice_join_hint"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Person.Meta" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/familyNameInputLayout"
                style="@style/Widget.ChildWatch.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_4"
                android:hint="@string/first_run_family_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/familyNameInput"
                    style="@style/Widget.ChildWatch.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/invitationInputLayout"
                style="@style/Widget.ChildWatch.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_4"
                android:hint="@string/parent_setup_invitation_hint"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/invitationInput"
                    style="@style/Widget.ChildWatch.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textNoSuggestions"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--
                The picture is part of who this person is, so it stays on the
                step that asks about the person and nowhere else.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarCard"
                style="@style/Widget.ChildWatch.PersonCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/cw_space_5">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatarImage"
                        style="@style/Widget.ChildWatch.Avatar.Hero"
                        android:contentDescription="@string/family_profile_avatar_description"
                        android:src="@drawable/avatar_family_sky" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_4"
                        android:gravity="center"
                        android:text="@string/family_profile_avatar_presets"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/cw_color_on_surface" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_3"
                        android:clipToPadding="false"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/parentAvatarPresetContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/parentAvatarPreset1"
                                style="@style/Widget.ChildWatch.Avatar.Medium"
                                android:contentDescription="@string/family_profile_avatar_description"
                                app:strokeColor="@color/cw_color_primary"
                                app:strokeWidth="3dp" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/parentAvatarPreset2"
                                style="@style/Widget.ChildWatch.Avatar.Medium"
                                android:layout_marginStart="@dimen/cw_space_2"
                                android:contentDescription="@string/family_profile_avatar_description" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/parentAvatarPreset3"
                                style="@style/Widget.ChildWatch.Avatar.Medium"
                                android:layout_marginStart="@dimen/cw_space_2"
                                android:contentDescription="@string/family_profile_avatar_description" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/parentAvatarPreset4"
                                style="@style/Widget.ChildWatch.Avatar.Medium"
                                android:layout_marginStart="@dimen/cw_space_2"
                                android:contentDescription="@string/family_profile_avatar_description" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/parentAvatarPreset5"
                                style="@style/Widget.ChildWatch.Avatar.Medium"
                                android:layout_marginStart="@dimen/cw_space_2"
                                android:contentDescription="@string/family_profile_avatar_description" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/parentAvatarPreset6"
                                style="@style/Widget.ChildWatch.Avatar.Medium"
                                android:layout_marginStart="@dimen/cw_space_2"
                                android:contentDescription="@string/family_profile_avatar_description" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changeAvatarButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_2"
                        android:text="@string/first_run_own_photo"
                        android:textAllCaps="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contacts stay optional and out of the way of the main decision. -->
            <TextView
                android:id="@+id/optionalContactsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_5"
                android:text="@string/first_run_optional_contacts"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="@color/cw_color_on_surface" />

            <TextView
                android:id="@+id/optionalContactsHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_1"
                android:text="@string/first_run_optional_contacts_hint"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/cw_color_on_surface_variant" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailInputLayout"
                style="@style/Widget.ChildWatch.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_3"
                android:hint="@string/first_run_email_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailInput"
                    style="@style/Widget.ChildWatch.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/phoneInputLayout"
                style="@style/Widget.ChildWatch.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_3"
                android:hint="@string/first_run_phone_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/phoneInput"
                    style="@style/Widget.ChildWatch.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="phone"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.ChildWatch.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/cw_space_3"
        android:layout_marginEnd="@dimen/cw_space_3"
        android:layout_marginBottom="@dimen/cw_space_2"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/cw_space_3"
            android:paddingTop="@dimen/cw_space_3"
            android:paddingEnd="@dimen/cw_space_3"
            android:paddingBottom="@dimen/cw_space_2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/cw_touch_target"
                android:text="@string/parent_setup_continue"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectFamilyButton"
                style="@style/Widget.ChildWatch.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cw_space_2"
                android:text="@string/first_run_connect_action"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/configureLaterButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/cw_touch_target"
                    android:text="@string/parent_setup_later"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/skipButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/cw_touch_target"
                    android:text="@string/parent_setup_have_invitation"
                    android:textAllCaps="false" />
            </LinearLayout>

            <!-- A phone whose family the app cannot see is not sent into a dead end. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/openAppButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/cw_touch_target"
                android:text="@string/first_run_open_app"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
