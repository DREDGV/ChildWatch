<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cw_color_background"
    tools:context=".ParentSetupActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="148dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Добро пожаловать в ChildWatch"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/cw_color_on_surface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Сначала расскажите, как к вам обращаться. Остальное можно добавить позже."
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/cw_color_on_surface_variant" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarCard"
                style="@style/Widget.ChildWatch.PersonCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatarImage"
                        style="@style/Widget.ChildWatch.Avatar.Hero"
                        android:contentDescription="@string/family_profile_avatar_description"
                        android:src="@drawable/avatar_family_sky" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="@string/family_profile_avatar_presets"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/cw_color_on_surface" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/parentAvatarPresetContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/parentAvatarPreset1"
                                style="@style/Widget.ChildWatch.Avatar.Medium"
                                android:contentDescription="@string/family_profile_avatar_description"
                                android:src="@drawable/avatar_family_sky"
                                app:strokeColor="@color/cw_color_primary"
                                app:strokeWidth="3dp"
                                />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/parentAvatarPreset2"
                                style="@style/Widget.ChildWatch.Avatar.Medium"
                                android:layout_marginStart="10dp"
                                android:contentDescription="@string/family_profile_avatar_description"
                                android:src="@drawable/avatar_family_mint"
                                />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/parentAvatarPreset3"
                                style="@style/Widget.ChildWatch.Avatar.Medium"
                                android:layout_marginStart="10dp"
                                android:contentDescription="@string/family_profile_avatar_description"
                                android:src="@drawable/avatar_family_sun"
                                />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/parentAvatarPreset4"
                                style="@style/Widget.ChildWatch.Avatar.Medium"
                                android:layout_marginStart="10dp"
                                android:contentDescription="@string/family_profile_avatar_description"
                                android:src="@drawable/avatar_family_coral"
                                />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/parentAvatarPreset5"
                                style="@style/Widget.ChildWatch.Avatar.Medium"
                                android:layout_marginStart="10dp"
                                android:contentDescription="@string/family_profile_avatar_description"
                                android:src="@drawable/avatar_family_lilac"
                                />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/parentAvatarPreset6"
                                style="@style/Widget.ChildWatch.Avatar.Medium"
                                android:layout_marginStart="10dp"
                                android:contentDescription="@string/family_profile_avatar_description"
                                android:src="@drawable/avatar_family_ocean"
                                />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changeAvatarButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Или выбрать своё фото"
                        android:textAllCaps="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameInputLayout"
                style="@style/Widget.ChildWatch.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Как вас зовут?">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nameInput"
                    style="@style/Widget.ChildWatch.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--
                Both ways into the application are offered side by side and with the
                same weight. Creating a family used to be the only visible path, and
                the second one was hidden behind a button, so a phone that meant to
                join an existing family created one of its own instead.
            -->
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/createFamilyRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:checked="true"
                android:text="Создать новую семью" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/joinFamilyRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Войти в существующую семью" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/familyNameInputLayout"
                style="@style/Widget.ChildWatch.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/parent_setup_family_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/familyNameInput"
                    style="@style/Widget.ChildWatch.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:text="Моя семья" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/invitationInputLayout"
                style="@style/Widget.ChildWatch.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/parent_setup_invitation_hint"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/invitationInput"
                    style="@style/Widget.ChildWatch.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Контакты — по желанию"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="@color/cw_color_on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Они не обязательны для начала работы и всегда доступны в профиле."
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/cw_color_on_surface_variant" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailInputLayout"
                style="@style/Widget.ChildWatch.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailInput"
                    style="@style/Widget.ChildWatch.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/phoneInputLayout"
                style="@style/Widget.ChildWatch.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Телефон">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/phoneInput"
                    style="@style/Widget.ChildWatch.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="phone"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/cw_color_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/cw_color_outline_variant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:text="@string/parent_setup_continue"
                android:textAllCaps="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/configureLaterButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/parent_setup_later"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/skipButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/parent_setup_have_invitation"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
