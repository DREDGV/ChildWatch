<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/qrTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Покажите этот QR-код"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/qrSubtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Отсканируйте его в ParentWatch (детское приложение)"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAlignment="center"
        android:layout_marginBottom="32dp" />

    <!-- QR-код -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="16dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <ImageView
            android:id="@+id/qrImageView"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:padding="16dp"
            android:contentDescription="QR-код устройства"
            android:scaleType="fitCenter" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Device ID (для справки) -->
    <TextView
        android:id="@+id/deviceIdText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Device ID: ..."
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:fontFamily="monospace"
        android:layout_marginTop="16dp" />

    <!-- Инструкция -->
    <TextView
        android:id="@+id/qrHelpText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Этот код связывает родительское и детское устройства для просмотра карты"
        android:textSize="14sp"
        android:textColor="?attr/colorPrimary"
        android:textAlignment="center"
        android:padding="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/rounded_background" />

</LinearLayout>
