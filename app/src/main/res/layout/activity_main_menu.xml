            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/selectedPersonActionsHint" android:textSize="12sp" android:layout_marginTop="8dp" android:textColor="@color/cw_color_on_surface_variant" android:text="@string/home_selected_choose_person" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/homeAttentionPanel" android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView android:id="@+id/setupNoticeCard" style="@style/Widget.ChildWatch.PersonCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/cw_space_4" android:visibility="gone" ns2:visibility="visible">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/cw_space_4">
                    <TextView android:id="@+id/setupNoticeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_setup_notice_title" android:textAppearance="@style/TextAppearance.ChildWatch.Person.Name" />
                    <TextView android:id="@+id/setupNoticeBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cw_space_1" android:text="@string/home_setup_notice_body" android:textAppearance="@style/TextAppearance.ChildWatch.Person.Supporting" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/setupNoticeButton" style="@style/Widget.ChildWatch.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cw_space_3" android:minHeight="@dimen/cw_touch_target" android:text="@string/home_setup_notice_action" android:textAllCaps="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/powerSettingsCard" style="@style/Widget.ChildWatch.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cw_space_4" android:visibility="gone" app:cardBackgroundColor="@color/cw_color_warning_container">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/cw_space_4">
                    <LinearLayout android:id="@+id/batteryOptimizationRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                        <TextView android:id="@+id/batteryOptimizationMessage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/battery_optimization_warning" android:textColor="@color/cw_color_on_warning_container" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/disableOptimizationButton" style="@style/Widget.ChildWatch.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/battery_optimization_button" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/powerSaverRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                        <TextView android:id="@+id/powerSaverMessage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/power_save_warning" android:textColor="@color/cw_color_on_warning_container" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/openPowerSaverButton" style="@style/Widget.ChildWatch.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/power_save_button" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <TextView android:id="@+id/locationStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/audioStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/photoStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/lastUpdateText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/lastAudioUpdateText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/lastPhotoUpdateText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/permissionsStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/batteryWarningText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.google.android.material.button.MaterialButton android:id="@+id/startMonitoringBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.google.android.material.button.MaterialButton android:id="@+id/stopMonitoringBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.google.android.material.button.MaterialButton android:id="@+id/emergencyStopBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/updateNoticeContainer" android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
