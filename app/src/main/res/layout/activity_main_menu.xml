<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cw_color_background"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/cw_space_5"
        android:paddingTop="@dimen/cw_space_6"
        android:paddingBottom="@dimen/cw_space_5">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_parent_title"
            android:textAppearance="@style/TextAppearance.ChildWatch.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_1"
            android:text="@string/home_parent_subtitle"
            android:textAppearance="@style/TextAppearance.ChildWatch.Body" />

        <TextView
            android:id="@+id/appVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/activeProfileCard"
            style="@style/Widget.ChildWatch.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/cw_space_4">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/activeProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_family_profile"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                    <TextView
                        android:id="@+id/activeProfileMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_1"
                        android:maxLines="2"
                        android:text="@string/home_family_child_missing"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Body" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/switchProfileQuickButton"
                    style="@style/Widget.ChildWatch.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cw_space_3"
                    android:text="@string/profile_switch_manage" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/powerSettingsCard"
            style="@style/Widget.ChildWatch.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_4"
            android:visibility="gone"
            app:cardBackgroundColor="@color/cw_color_warning_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/cw_space_4">

                <LinearLayout
                    android:id="@+id/batteryOptimizationRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/batteryOptimizationMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/battery_optimization_warning"
                        android:textColor="@color/cw_color_on_warning_container" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/disableOptimizationButton"
                        style="@style/Widget.ChildWatch.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_optimization_button" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/powerSaverRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/powerSaverMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/power_save_warning"
                        android:textColor="@color/cw_color_on_warning_container" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openPowerSaverButton"
                        style="@style/Widget.ChildWatch.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/power_save_button" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/childSelectionCard"
            style="@style/Widget.ChildWatch.Card.Interactive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_4">

            <LinearLayout
                android:id="@+id/childSelectionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/cw_space_4">

                <ImageView
                    android:id="@+id/selectedChildAvatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/main_child_card_button_hint"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_myplaces" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cw_space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/selectedChildName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/main_select_contact_placeholder_title"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                    <TextView
                        android:id="@+id/selectedChildDeviceId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_1"
                        android:text="@string/home_selected_child_hint"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Label" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/childSelectionEditIcon"
                    style="@style/Widget.ChildWatch.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cw_space_2"
                    android:text="@string/main_child_card_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusCard"
            style="@style/Widget.ChildWatch.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/cw_space_4">

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/monitoring_status"
                    android:src="@android:drawable/presence_offline"
                    app:tint="@color/cw_color_warning" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cw_space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/monitoring_inactive"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                    <TextView
                        android:id="@+id/serviceRunningTimeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_1"
                        android:text="@string/service_running_time"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Label" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/monitoringToggleBtn"
                    style="@style/Widget.ChildWatch.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cw_space_2"
                    android:text="@string/home_monitoring_action" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_6"
            android:text="@string/home_quick_actions"
            android:textAppearance="@style/TextAppearance.ChildWatch.Headline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_3"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/audioStreamingCard"
                style="@style/Widget.ChildWatch.Card.Interactive"
                android:layout_width="0dp"
                android:layout_height="136dp"
                android:layout_marginEnd="@dimen/cw_space_2"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cw_space_3">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/home_action_listen"
                        android:src="@android:drawable/ic_lock_silent_mode_off"
                        app:tint="@color/cw_color_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_2"
                        android:text="@string/home_action_listen"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/home_action_listen_hint"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/remoteCameraCard"
                style="@style/Widget.ChildWatch.Card.Interactive"
                android:layout_width="0dp"
                android:layout_height="136dp"
                android:layout_marginStart="@dimen/cw_space_2"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cw_space_3">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/home_action_photo"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="@color/cw_color_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_2"
                        android:text="@string/home_action_photo"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/home_action_photo_hint"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_4"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chatCard"
                style="@style/Widget.ChildWatch.Card.Interactive"
                android:layout_width="0dp"
                android:layout_height="136dp"
                android:layout_marginEnd="@dimen/cw_space_2"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/cw_space_3">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/home_action_chat"
                            android:src="@android:drawable/ic_dialog_email"
                            app:tint="@color/cw_color_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cw_space_2"
                            android:text="@string/home_action_chat"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_action_chat_hint"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Label" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chatBadge"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|top"
                        android:background="@drawable/badge_background"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/attentionSignalCard"
                style="@style/Widget.ChildWatch.Card.Interactive"
                android:layout_width="0dp"
                android:layout_height="136dp"
                android:layout_marginStart="@dimen/cw_space_2"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cw_space_3">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/home_action_signal"
                        android:src="@android:drawable/ic_dialog_alert"
                        app:tint="@color/cw_color_error" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_2"
                        android:text="@string/home_action_signal"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_action_signal_hint"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_4"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/parentLocationCard"
                style="@style/Widget.ChildWatch.Card.Interactive"
                android:layout_width="0dp"
                android:layout_height="136dp"
                android:layout_marginEnd="@dimen/cw_space_2"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cw_space_3">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/home_action_map"
                        android:src="@android:drawable/ic_dialog_map"
                        app:tint="@color/cw_color_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_2"
                        android:text="@string/home_action_map"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/home_action_map_hint"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/settingsCard"
                style="@style/Widget.ChildWatch.Card.Interactive"
                android:layout_width="0dp"
                android:layout_height="136dp"
                android:layout_marginStart="@dimen/cw_space_2"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cw_space_3">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/home_settings"
                        android:src="@android:drawable/ic_menu_preferences"
                        app:tint="@color/cw_color_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_2"
                        android:text="@string/home_settings"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/deviceInfoCard"
            style="@style/Widget.ChildWatch.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/cw_space_4">

                <TextView
                    android:id="@+id/deviceInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_device_summary"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                <TextView
                    android:id="@+id/deviceInfoDeviceId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/deviceInfoProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/cw_space_3"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/deviceInfoStatusMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_2"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Body"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/deviceInfoContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_3"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/deviceInfoBatteryValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Body" />

                    <TextView
                        android:id="@+id/deviceInfoChargingValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_1"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Body" />

                    <TextView
                        android:id="@+id/deviceInfoTemperatureValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_1"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Body" />

                    <TextView
                        android:id="@+id/deviceInfoModelValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_1"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Body" />

                    <TextView
                        android:id="@+id/deviceInfoCurrentAppValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_1"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Body" />

                    <TextView
                        android:id="@+id/deviceInfoUpdatedValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_2"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Label" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deviceUsageButton"
                    style="@style/Widget.ChildWatch.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_3"
                    android:text="@string/home_action_activity" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Compatibility-only controls and technical status remain available to code,
             but raw identifiers and service diagnostics no longer clutter the home screen. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView android:id="@+id/locationStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/audioStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/photoStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/lastUpdateText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/lastAudioUpdateText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/lastPhotoUpdateText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/permissionsStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/batteryWarningText" android:layout_width="wrap_content" android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startMonitoringBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopMonitoringBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emergencyStopBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
