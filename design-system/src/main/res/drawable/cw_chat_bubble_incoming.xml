<?xml version="1.0" encoding="utf-8"?>
<!--
    Message bubble backgrounds.

    One flattened bottom corner points the bubble at its author: the left corner for
    an incoming message, the right one for an outgoing message. The two shapes are
    otherwise identical, so a conversation reads as one column of speech.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp"
        android:bottomLeftRadius="6dp"
        android:bottomRightRadius="20dp" />
    <solid android:color="@color/cw_chat_bubble_incoming" />
    <stroke
        android:width="2dp"
        android:color="@color/cw_chat_bubble_incoming_stroke" />
</shape>
