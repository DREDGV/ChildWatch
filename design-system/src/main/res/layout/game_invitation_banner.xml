<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/gameInviteMessage" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp" android:maxLines="3"
        android:ellipsize="end" android:textColor="@color/cw_color_inverse_on_surface" />
    <LinearLayout android:id="@+id/gameInviteActions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="end" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/gameInviteLater"
            style="?attr/borderlessButtonStyle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:textColor="@color/cw_color_inverse_primary" android:text="@string/cw_game_invitation_later" />
        <com.google.android.material.button.MaterialButton android:id="@+id/gameInviteOpen"
            style="?attr/borderlessButtonStyle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:textColor="@color/cw_color_inverse_primary" android:text="@string/cw_game_invitation_open" />
    </LinearLayout>
</LinearLayout>
