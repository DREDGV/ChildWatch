<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gamesRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/cw_color_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/gamesClose"
            style="@style/Widget.ChildWatch.Button.Secondary"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:textAllCaps="false" android:text="@string/cw_games_close" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="16dp" android:text="@string/cw_home_games"
            android:textSize="24sp" android:textStyle="bold" android:accessibilityHeading="true"
            android:textColor="@color/cw_color_on_surface" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/cw_catalog_intro"
            android:textAppearance="@style/TextAppearance.ChildWatch.Body" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/gamesArcanoid"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/cw_arcanoid_title"
            app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp"
            app:strokeColor="@color/cw_color_outline_variant" app:cardBackgroundColor="@color/cw_color_surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:importantForAccessibility="noHideDescendants">
                <ru.example.childwatch.designsystem.GameArtworkView android:id="@+id/gamesArcanoidArtwork"
                    android:layout_width="match_parent" android:layout_height="144dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/cw_arcanoid_title" android:textAppearance="@style/TextAppearance.ChildWatch.Headline" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="@string/cw_catalog_arkanoid_desc" android:textAppearance="@style/TextAppearance.ChildWatch.Body" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="@string/cw_catalog_solo" android:textSize="14sp" android:textColor="@color/cw_color_on_surface_variant" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="@string/cw_catalog_choose" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/cw_color_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/gamesBattleship"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/cw_catalog_battleship_title"
            app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp"
            app:strokeColor="@color/cw_color_outline_variant" app:cardBackgroundColor="@color/cw_color_surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:importantForAccessibility="noHideDescendants">
                <ru.example.childwatch.designsystem.GameArtworkView android:id="@+id/gamesBattleshipArtwork"
                    android:layout_width="match_parent" android:layout_height="144dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/cw_catalog_battleship_title" android:textAppearance="@style/TextAppearance.ChildWatch.Headline" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="@string/cw_catalog_battleship_desc" android:textAppearance="@style/TextAppearance.ChildWatch.Body" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="@string/cw_catalog_battleship_modes" android:textSize="14sp" android:textColor="@color/cw_color_on_surface_variant" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="@string/cw_catalog_choose" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/cw_color_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/gamesSnake"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/cw_catalog_snake_title"
            app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp"
            app:strokeColor="@color/cw_color_outline_variant" app:cardBackgroundColor="@color/cw_color_surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:importantForAccessibility="noHideDescendants">
                <ru.example.childwatch.designsystem.GameArtworkView android:id="@+id/gamesSnakeArtwork"
                    android:layout_width="match_parent" android:layout_height="144dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/cw_catalog_snake_title" android:textAppearance="@style/TextAppearance.ChildWatch.Headline" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="@string/cw_catalog_snake_desc" android:textAppearance="@style/TextAppearance.ChildWatch.Body" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="@string/cw_catalog_solo" android:textSize="14sp" android:textColor="@color/cw_color_on_surface_variant" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="@string/cw_catalog_choose" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/cw_color_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
