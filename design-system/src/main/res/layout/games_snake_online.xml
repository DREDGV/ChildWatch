<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/snakeOnlineRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/cw_game_ocean">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/snakeOnlineBack"
            style="@style/Widget.ChildWatch.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:textAllCaps="false" android:textColor="@color/cw_game_white" android:text="@string/cw_games_close" />
        <TextView android:id="@+id/snakeOnlineScore" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:textSize="16sp" android:textColor="@color/cw_game_white" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/snakeOnlinePause"
            style="@style/Widget.ChildWatch.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:textAllCaps="false" android:textColor="@color/cw_game_white" android:text="@string/cw_snake_online_pause" />
    </LinearLayout>
    <TextView android:id="@+id/snakeOnlinePeer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:textSize="14sp" android:textColor="@color/cw_game_white" />
    <TextView android:id="@+id/snakeOnlineStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="4dp" android:paddingBottom="4dp"
        android:textSize="16sp" android:textColor="@color/cw_game_white" android:accessibilityLiveRegion="polite" />
    <FrameLayout android:id="@+id/snakeOnlineField" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <com.google.android.material.button.MaterialButton android:id="@+id/snakeOnlineReady"
        style="@style/Widget.ChildWatch.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:minHeight="48dp"
        android:textAllCaps="false" android:text="@string/cw_snake_online_ready" />
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/snakeOnlineButtons"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp"
        android:minHeight="48dp" android:text="@string/cw_snake_online_buttons" android:textColor="@color/cw_game_white"
        android:buttonTint="@color/cw_game_mint" />
    <LinearLayout android:id="@+id/snakeOnlineControls" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/snakeOnlineLeft" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp" android:text="←" android:contentDescription="@string/cw_snake_online_left" android:textSize="24sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/snakeOnlineUp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp" android:text="↑" android:contentDescription="@string/cw_snake_online_up" android:textSize="24sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/snakeOnlineDown" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp" android:text="↓" android:contentDescription="@string/cw_snake_online_down" android:textSize="24sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/snakeOnlineRight" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp" android:text="→" android:contentDescription="@string/cw_snake_online_right" android:textSize="24sp" />
    </LinearLayout>
</LinearLayout>
