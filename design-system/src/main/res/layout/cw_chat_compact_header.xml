<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cw_color_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chatBack"
            style="@style/Widget.ChildWatch.Chat.HeaderAction"
            android:contentDescription="@string/chat_header_back"
            app:icon="@drawable/cw_chat_back" />

        <LinearLayout
            android:id="@+id/chatHeaderIdentity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chatHeaderAvatar"
                style="@style/Widget.ChildWatch.Avatar.Medium"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chatHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Header.Title" />

                <TextView
                    android:id="@+id/chatHeaderSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Header.Status"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chatHeaderSearch"
            style="@style/Widget.ChildWatch.Chat.HeaderAction"
            android:contentDescription="@string/chat_search_title"
            app:icon="@drawable/cw_chat_search" />
    </LinearLayout>

    <TextView
        android:id="@+id/chatConnectionNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Notice"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cw_color_outline_variant"
        android:importantForAccessibility="no" />
</LinearLayout>
