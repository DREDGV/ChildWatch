<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cw_color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/cw_space_5"
        android:paddingTop="@dimen/cw_space_6"
        android:paddingBottom="@dimen/cw_space_5">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/home_child_brand"
            android:textAppearance="@style/TextAppearance.ChildWatch.Display" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ChildWatch.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_5"
            app:cardBackgroundColor="@color/cw_color_primary_container"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/cw_space_6">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:contentDescription="@string/home_child_protection_active"
                    android:padding="@dimen/cw_space_4"
                    android:src="@drawable/ic_logo_childdevice"
                    app:tint="@color/cw_color_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_3"
                    android:text="@string/home_child_protection_active"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Headline"
                    android:textColor="@color/cw_color_success" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_2"
                    android:gravity="center"
                    android:text="@string/home_child_protection_subtitle"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/activeProfileCard"
            style="@style/Widget.ChildWatch.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/cw_space_4">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/activeProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_switch_title"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                    <TextView
                        android:id="@+id/activeProfileMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_1"
                        android:maxLines="2"
                        android:text="@string/home_child_profile_connected"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Body" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/switchProfileQuickButton"
                    style="@style/Widget.ChildWatch.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cw_space_3"
                    android:text="@string/profile_switch_manage" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_4"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chatCard"
                style="@style/Widget.ChildWatch.Card.Interactive"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginEnd="@dimen/cw_space_2"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/cw_space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/home_child_chat"
                            android:src="@android:drawable/ic_dialog_email"
                            app:tint="@color/cw_color_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cw_space_2"
                            android:text="@string/home_child_chat"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/home_child_chat_hint"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Label" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chatBadge"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|top"
                        android:background="@drawable/badge_background"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/parentLocationCard"
                style="@style/Widget.ChildWatch.Card.Interactive"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginStart="@dimen/cw_space_2"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cw_space_4">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/home_child_map"
                        android:src="@android:drawable/ic_dialog_map"
                        app:tint="@color/cw_color_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_2"
                        android:gravity="center"
                        android:text="@string/home_child_map"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/home_child_map_hint"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_4"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/attentionSignalCard"
                style="@style/Widget.ChildWatch.Card.Interactive"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginEnd="@dimen/cw_space_2"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cw_space_4">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/home_child_signal"
                        android:src="@android:drawable/ic_dialog_alert"
                        app:tint="@color/cw_color_warning" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_2"
                        android:gravity="center"
                        android:text="@string/home_child_signal"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/home_child_signal_hint"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/settingsCard"
                style="@style/Widget.ChildWatch.Card.Interactive"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginStart="@dimen/cw_space_2"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cw_space_4">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/home_child_settings"
                        android:src="@android:drawable/ic_menu_preferences"
                        app:tint="@color/cw_color_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cw_space_2"
                        android:text="@string/home_child_settings"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/home_child_settings_hint"
                        android:textAppearance="@style/TextAppearance.ChildWatch.Label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/lastUpdateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cw_space_5"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.ChildWatch.Label" />
    </LinearLayout>
</ScrollView>
