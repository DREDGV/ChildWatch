<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="40dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:gravity="end"
    android:orientation="vertical">

    <TextView
        android:id="@+id/senderText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="2dp"
        android:text="@string/chat_partner_parent"
        android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Meta.OnPrimary" />

    <com.vanniktech.emoji.EmojiTextView
        android:id="@+id/messageText"
        style="@style/Widget.ChildWatch.ChatBubble.Outgoing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/timestampText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:34"
            android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Meta.OnPrimary" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="вњ“"
            android:textAppearance="@style/TextAppearance.ChildWatch.Chat.Meta.OnPrimary" />

        <!-- Offered only for a message that failed to send, so it stays hidden
             otherwise and is filled in by the adapter. -->
        <TextView
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:text="РџРѕРІС‚РѕСЂ"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
