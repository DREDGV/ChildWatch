<?xml version="1.0" encoding="utf-8"?>
<!--
    The one screen a new ChildDevice phone needs, told as two steps.

    Step one takes the code from the adult's phone. Step two says what was
    decided - which family, which person, which phone to pick up next - so the
    child never has to understand the words "family", "invitation" or "member".
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cw_color_background"
    tools:context=".FamilyJoinActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/cw_color_surface"
            android:elevation="0dp"
            android:title="@string/child_join_toolbar_title"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:titleTextColor="@color/cw_color_on_surface" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/joinScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/cw_space_6"
                android:paddingTop="@dimen/cw_space_6"
                android:paddingEnd="@dimen/cw_space_6"
                android:paddingBottom="@dimen/cw_space_8">

                <TextView
                    android:id="@+id/joinTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/child_join_title"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="@color/cw_color_on_surface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/joinSubtitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_2"
                    android:text="@string/child_join_subtitle"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="@color/cw_color_on_surface_variant" />

                <TextView
                    android:id="@+id/stepIndicatorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_4"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Person.Meta"
                    tools:text="Шаг 1 из 2" />

                <!-- What is already true, when it is. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/linkedStateCard"
                    style="@style/Widget.ChildWatch.PersonCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_4"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/cw_space_4">

                        <TextView
                            android:id="@+id/linkedStateTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Status.Success" />

                        <TextView
                            android:id="@+id/linkedStateBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cw_space_1"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Person.Supporting" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/howItWorksCard"
                    style="@style/Widget.ChildWatch.PersonCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/cw_space_4">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/child_join_how_title"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Person.Name" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cw_space_2"
                            android:text="@string/child_join_how_steps"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Person.Supporting" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scanButton"
                    style="@style/Widget.ParentWatch.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_5"
                    android:minHeight="@dimen/cw_touch_target"
                    android:text="@string/child_join_scan"
                    android:textAllCaps="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_4"
                    android:gravity="center"
                    android:id="@+id/orPasteText"
                    android:text="@string/child_join_or_paste"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Person.Meta"
                    android:textColor="@color/cw_color_on_surface_variant" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/codeInputLayout"
                    style="@style/Widget.ChildWatch.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_2"
                    android:hint="@string/child_join_code_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/codeInput"
                        style="@style/Widget.ChildWatch.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textUri|textNoSuggestions"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/previewButton"
                    style="@style/Widget.ParentWatch.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_3"
                    android:minHeight="@dimen/cw_touch_target"
                    android:text="@string/child_join_check"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_3"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.ChildWatch.Person.Supporting"
                    android:textColor="@color/cw_color_error"
                    android:visibility="gone"
                    tools:text="Приглашение больше не действует" />

                <!--
                    Step two: what was decided. It is a separate card so the person
                    sees a confirmation rather than a form that suddenly grew.
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/previewCard"
                    style="@style/Widget.ChildWatch.PersonCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_5"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/cw_space_5">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/child_join_check_title"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Person.Supporting" />

                        <TextView
                            android:id="@+id/memberNameText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cw_space_3"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                            android:textColor="@color/cw_color_on_surface"
                            android:textStyle="bold"
                            tools:text="Лёва" />

                        <TextView
                            android:id="@+id/familyNameText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cw_space_1"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Person.Name"
                            android:textColor="@color/cw_color_primary"
                            tools:text="Семья Ермошкиных" />

                        <TextView
                            android:id="@+id/roleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cw_space_3"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Person.Supporting"
                            tools:text="Роль: ребёнок" />

                        <TextView
                            android:id="@+id/invitedByText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cw_space_1"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Person.Meta"
                            tools:text="Приглашение создал: Григорий" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cw_space_3"
                            android:text="@string/child_join_confirm_note"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Person.Meta" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/acceptButton"
                            style="@style/Widget.ParentWatch.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cw_space_4"
                            android:minHeight="@dimen/cw_touch_target"
                            android:text="@string/child_join_accept"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Step two, finished: nothing left to do on this phone. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/doneCard"
                    style="@style/Widget.ChildWatch.PersonCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_5"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/cw_space_5">

                        <TextView
                            android:id="@+id/doneTitleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Status.Success" />

                        <TextView
                            android:id="@+id/doneBodyText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cw_space_2"
                            android:textAppearance="@style/TextAppearance.ChildWatch.Person.Supporting" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/openAppButton"
                            style="@style/Widget.ParentWatch.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cw_space_4"
                            android:minHeight="@dimen/cw_touch_target"
                            android:text="@string/child_join_open_app"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Nothing here is a dead end: this phone works without a family too. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/laterButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cw_space_3"
                    android:minHeight="@dimen/cw_touch_target"
                    android:text="@string/child_join_later"
                    android:textAllCaps="false" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
