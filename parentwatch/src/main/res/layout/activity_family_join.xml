<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cw_color_background"
    tools:context=".FamilyJoinActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/cw_color_surface"
            android:elevation="0dp"
            android:title="Подключение к семье"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:titleTextColor="@color/cw_color_on_surface" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Добавьте этот телефон"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="@color/cw_color_on_surface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="На телефоне взрослого создайте приглашение. Оно определит семью и человека, которому принадлежит этот телефон."
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="@color/cw_color_on_surface_variant" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.ChildWatch.PersonCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Как это работает"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/cw_color_on_surface"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="1. Взрослый выбирает человека или создаёт нового.\n2. Вы сканируете одноразовый QR-код.\n3. Имя и аватар появляются одинаково во всех функциях ChildWatch."
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/cw_color_on_surface_variant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scanButton"
                    style="@style/Widget.ParentWatch.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="52dp"
                    android:text="Сканировать приглашение"
                    android:textAllCaps="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="или вставьте ссылку"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/cw_color_on_surface_variant" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/codeInputLayout"
                    style="@style/Widget.ChildWatch.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Ссылка приглашения">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/codeInput"
                        style="@style/Widget.ChildWatch.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textUri|textNoSuggestions"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/previewButton"
                    style="@style/Widget.ParentWatch.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Проверить приглашение"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/cw_color_error"
                    android:visibility="gone"
                    tools:text="Приглашение больше не действует" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/previewCard"
                    style="@style/Widget.ChildWatch.PersonCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Проверьте данные"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/cw_color_on_surface_variant" />

                        <TextView
                            android:id="@+id/memberNameText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                            android:textColor="@color/cw_color_on_surface"
                            android:textStyle="bold"
                            tools:text="Лёва" />

                        <TextView
                            android:id="@+id/familyNameText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/cw_color_primary"
                            tools:text="Семья Ермошкиных" />

                        <TextView
                            android:id="@+id/roleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            android:textColor="@color/cw_color_on_surface_variant"
                            tools:text="Роль: ребёнок" />

                        <TextView
                            android:id="@+id/invitedByText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/cw_color_on_surface_variant"
                            tools:text="Приглашение создал: Григорий" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="После подтверждения этот телефон будет принадлежать выбранному человеку. Изменить это можно будет только новым приглашением."
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/cw_color_on_surface_variant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/acceptButton"
                            style="@style/Widget.ParentWatch.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:minHeight="52dp"
                            android:text="Добавить телефон в семью"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
