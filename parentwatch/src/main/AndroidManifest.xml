<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Audio recording permission -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Camera permission for remote photo capture -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Internet permission -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Installing an update.

        Android requires this to hand a downloaded package to the installer. The
        application never installs anything by itself: the request always passes
        through the system installer, which shows the person what is about to be
        installed and lets them refuse.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Foreground service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wake lock -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Boot receiver -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- Get tasks permission for foreground check -->
    <uses-permission android:name="android.permission.GET_TASKS" />

    <!-- Package usage stats permission (for app tracking) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: usage statistics may mention packages that
         are not otherwise visible to ChildDevice. Limit discovery to ordinary
         launcher applications instead of requesting QUERY_ALL_PACKAGES. -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ChildWatchApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
    android:theme="@style/Theme.ParentWatch"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity android:name=".debug.AssistantPilotControlActivity" android:enabled="true"
            android:exported="false" android:label="@string/assistant_recovery_title" />
        <service android:name=".debug.FamilyRecognitionService" android:enabled="false"
            android:exported="true" android:permission="android.permission.BIND_SPEECH_RECOGNITION">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>
        <service android:name=".debug.FamilyAssistantService" android:label="Семейный помощник ChildWatch"
            android:enabled="false" android:exported="true" android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService" /></intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/family_assistant" />
        </service>
        <service android:name=".debug.FamilyAssistantSessionService" android:enabled="false"
            android:exported="true" android:permission="android.permission.BIND_VOICE_INTERACTION" />


        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".FamilyJoinActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="childwatch" android:host="family" android:path="/join" />
            </intent-filter>
        </activity>

        <!-- Chat Activity -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ChatConversationsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ChatConversationV2Activity"
            android:exported="false"
            android:parentActivityName=".ChatConversationsActivity"
            android:screenOrientation="portrait" />

        <!-- Dual Location Map Activity -->
        <activity
            android:name=".DualLocationMapActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- QR Code Activity -->
        <activity
            android:name=".QrCodeActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:screenOrientation="portrait" />

        <!-- QR Scanner Activity -->
        <activity
            android:name=".QrScannerActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:screenOrientation="portrait" />

        <!-- About Activity -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <!-- Stats Activity -->
        <activity
            android:name=".StatsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <!-- Remote Camera Activity removed: this feature belongs to ParentMonitor only -->

        <!-- Location Service -->
        <service
            android:name=".service.LocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location|microphone|camera" />

        <!-- Audio Streaming Service -->
        <service
            android:name=".service.AudioStreamingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Chat Notification Service (deprecated - use ChatBackgroundService) -->
        <service
            android:name=".service.ChatNotificationService"
            android:enabled="false"
            android:exported="false" />

        <!-- Chat Background Service -->
        <service
            android:name=".service.ChatBackgroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Photo Capture Service -->
        <service
            android:name=".service.PhotoCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Optional fully managed test-device enrollment. Ordinary installs gain no role. -->
        <receiver
            android:name=".management.ChildDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/child_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".management.ManagedProvisioningActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Boot Receiver -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.REBOOT" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Notification Reply Receiver -->
        <receiver
            android:name=".receiver.NotificationReplyReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="ru.example.parentwatch.ACTION_REPLY" />
            </intent-filter>
        </receiver>

        <!--
        Reports how an installation ended.

        When an update replaces the application, Android kills this process, so the
        screen that started the installation is gone and cannot receive the result.
        A receiver declared here is started for that one message instead, which is
        the only way the outcome survives the replacement.
    -->
    <receiver
        android:name=".update.UpdateResultReceiver"
        android:exported="false" />

    <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fileprovider"
        android:exported="false" android:grantUriPermissions="true">
        <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/chat_file_paths" />
    </provider>
</application>

</manifest>
